{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_config.schema.json",
  "title": "AgentConfig",
  "description": "Конфигурация тенанта (поле config JSONB таблицы AgentConfig). Вся бизнес-специфика — здесь, не в коде ядра.",
  "type": "object",
  "properties": {
    "assistant": { "$ref": "#/$defs/AssistantConfig" },
    "model": { "$ref": "#/$defs/ModelsConfig" },
    "limits": { "$ref": "#/$defs/LimitsConfig" },
    "prompt": { "$ref": "#/$defs/PromptConfig" },
    "tools": { "$ref": "#/$defs/ToolsConfig" },
    "forms": {
      "type": "object",
      "description": "Ключ — form_key (используется в show_form и в component.form_id).",
      "additionalProperties": { "$ref": "#/$defs/FormConfig" },
      "default": {}
    },
    "knowledge": { "$ref": "#/$defs/KnowledgeConfig" },
    "branding": { "$ref": "#/$defs/BrandingConfig" }
  },
  "required": ["assistant", "model", "limits", "prompt", "tools"],
  "additionalProperties": false,
  "$defs": {
    "AssistantConfig": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "language": {
          "type": "string",
          "enum": ["auto", "ru", "en", "sv"],
          "default": "auto"
        },
        "greeting": { "type": "string" },
        "starter_suggestions": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "fallback_message": { "type": "string" },
        "confirm_labels": { "$ref": "#/$defs/ConfirmLabels" }
      },
      "required": ["name", "greeting", "fallback_message"],
      "additionalProperties": false
    },
    "ConfirmLabels": {
      "type": "object",
      "description": "Подписи кнопок компонента confirm у инструментов с requires_confirmation (ADR-0021).",
      "properties": {
        "confirm": { "type": "string", "minLength": 1, "default": "Подтвердить" },
        "cancel": { "type": "string", "minLength": 1, "default": "Отмена" }
      },
      "additionalProperties": false
    },
    "ModelConfig": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["openai", "openai_compatible", "anthropic"],
          "description": "Протокол API, а не производитель модели (ADR-0010): openai — OpenAI Responses API, openai_compatible — Chat Completions OpenAI-совместимого API (прокси, локальные серверы; например, модель anthropic/… через прокси), anthropic — Anthropic Messages API."
        },
        "name": { "type": "string" },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Подсказка, не требование (ADR-0009): применяется, только если провайдер и модель её поддерживают, иначе адаптер её отбрасывает. Не задана — значение провайдера по умолчанию."
        }
      },
      "required": ["provider", "name"],
      "additionalProperties": false
    },
    "ModelsConfig": {
      "type": "object",
      "properties": {
        "primary": { "$ref": "#/$defs/ModelConfig" },
        "fallback": {
          "oneOf": [{ "$ref": "#/$defs/ModelConfig" }, { "type": "null" }],
          "default": null
        }
      },
      "required": ["primary"],
      "additionalProperties": false
    },
    "LimitsConfig": {
      "type": "object",
      "properties": {
        "max_steps": { "type": "integer", "minimum": 1, "default": 6 },
        "max_tool_calls_per_step": { "type": "integer", "minimum": 1, "default": 4 },
        "turn_timeout_s": { "type": "number", "exclusiveMinimum": 0, "default": 60 },
        "max_tool_retries": { "type": "integer", "minimum": 0, "default": 2 }
      },
      "additionalProperties": false
    },
    "SlotDefinition": {
      "type": "object",
      "description": "Слот сценария (DialogState). Для type=array элементы описывает items.",
      "properties": {
        "type": { "type": "string", "enum": ["string", "number", "boolean", "array"] },
        "description": { "type": "string" },
        "enum": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Допустимые значения (для string)."
        },
        "items": {
          "title": "SlotItems",
          "type": "object",
          "description": "Используется при type=array, напр. concerns[] из пилота beauty.",
          "properties": {
            "type": { "type": "string", "enum": ["string", "number"] },
            "enum": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "ScenarioConfig": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string" },
        "instructions": { "type": "string" },
        "slots": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/SlotDefinition" },
          "default": {}
        }
      },
      "required": ["key", "description", "instructions"],
      "additionalProperties": false
    },
    "PromptConfig": {
      "type": "object",
      "properties": {
        "tenant": {
          "type": "string",
          "description": "Tenant-слой промпта: роль, тон, о компании, границы (см. architecture.md §6)."
        },
        "scenarios": {
          "type": "array",
          "items": { "$ref": "#/$defs/ScenarioConfig" },
          "default": []
        }
      },
      "required": ["tenant"],
      "additionalProperties": false
    },
    "ToolsConfig": {
      "type": "object",
      "properties": {
        "builtin": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "search_knowledge",
              "search_catalog",
              "get_entity",
              "show_entities",
              "update_dialog_state",
              "suggest_replies",
              "show_form",
              "create_lead",
              "handoff_to_human"
            ]
          },
          "default": []
        },
        "custom": {
          "type": "array",
          "items": { "$ref": "tools.schema.json#/$defs/HttpToolDefinition" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "FormConfig": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "components.schema.json#/$defs/FormField" },
          "minItems": 1
        }
      },
      "required": ["title", "fields"],
      "additionalProperties": false
    },
    "KnowledgeSearchConfig": {
      "type": "object",
      "properties": {
        "top_k": { "type": "integer", "minimum": 1, "default": 6 },
        "rerank": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "CatalogConfig": {
      "type": "object",
      "properties": {
        "entity_types": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Типы позиций каталога (Entity.type) → описание для модели; search_catalog принимает filters.type только из них.",
          "default": {}
        },
        "filterable_attributes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Имена полей Entity.attributes, по которым search_catalog принимает фильтры.",
          "default": []
        },
        "attribute_labels": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "Подписи атрибутов Entity.attributes для пользователя; show_entities(layout=comparison) выводит строки только для них, в этом порядке.",
          "default": {}
        },
        "card_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/CardAction" },
          "maxItems": 3,
          "description": "Кнопки каждой product_card из show_entities; payload кнопки — {entity_id}.",
          "default": []
        }
      },
      "additionalProperties": false
    },
    "CardAction": {
      "type": "object",
      "description": "Кнопка карточки позиции: нажатие отправляет input.type=action с payload {entity_id}.",
      "properties": {
        "action_id": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "style": {
          "type": "string",
          "enum": ["primary", "secondary", "link"],
          "default": "secondary"
        }
      },
      "required": ["action_id", "label"],
      "additionalProperties": false
    },
    "KnowledgeConfig": {
      "type": "object",
      "properties": {
        "search_knowledge": { "$ref": "#/$defs/KnowledgeSearchConfig" },
        "catalog": { "$ref": "#/$defs/CatalogConfig" }
      },
      "additionalProperties": false
    },
    "BrandingTokens": {
      "type": "object",
      "description": "Дизайн-токены чата: значения попадают в CSS-переменные, поэтому форматы строгие.",
      "properties": {
        "primary": {
          "type": "string",
          "description": "Основной цвет (кнопки, сообщения посетителя): #RGB или #RRGGBB.",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
        },
        "radius": {
          "type": "string",
          "description": "Радиус скругления: 0 или число с px / rem / em.",
          "pattern": "^(0|[0-9]+(\\.[0-9]+)?(px|rem|em))$"
        },
        "font": {
          "type": "string",
          "description": "Имя семейства шрифта (без загрузки: нет у посетителя — системный).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{0,63}$"
        }
      },
      "additionalProperties": true
    },
    "BrandingConfig": {
      "type": "object",
      "properties": {
        "tokens": { "$ref": "#/$defs/BrandingTokens" },
        "logo_url": {
          "type": ["string", "null"],
          "default": null,
          "description": "Логотип в шапке чата: https://… или путь от корня веб-приложения.",
          "pattern": "^(https?://|/)[^\\s\"'<>()\\\\]*$"
        }
      },
      "additionalProperties": false
    }
  }
}

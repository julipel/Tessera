# При изменении POSTGRES_* обнови DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Пул соединений API на процесс: потолок одновременных ходов (P7-05).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
NEXT_PUBLIC_API_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge
# Эмбеддинги чанков знаний (ключ и base_url — OPENAI_*). Смена модели — новая коллекция.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Реранкинг search_knowledge (ADR-0015): полный URL /rerank в формате Cohere/Jina, напр.
# https://api.cohere.com/v2/rerank (rerank-v3.5) или https://api.jina.ai/v1/rerank
# (jina-reranker-v2-base-multilingual). Пусто — без реранкинга.
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
# Файлы источников file: <dir>/<tenant_id>/<source_id>/. По умолчанию — data/knowledge в корне.
# KNOWLEDGE_FILES_DIR=/srv/knowledge
# Секреты источников http_api/database (ADR-0017): конфиг ссылается на имя переменной,
# разрешены только SOURCE_SECRET_*.
# SOURCE_SECRET_DEMO_API=
# Приватные подсети для источников database (ADR-0018), JSON-список CIDR; публичные адреса
# разрешены всегда. Локальный Postgres: ["127.0.0.0/8", "::1/128"].
# SOURCE_DB_ALLOWED_NETWORKS=[]
# provider: openai — OpenAI Responses API (ADR-0010). Пусто — официальный endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# provider: openai_compatible — Chat Completions совместимого API, напр. https://routerai.ru/api/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
ANTHROPIC_API_KEY=
EMBEDDINGS_MODEL=
# Лимиты частоты публичного API (ADR-0030); 0 — правило выключено.
# RATE_TURNS_PER_IP_PER_MIN=20
# RATE_TURNS_PER_TENANT_PER_MIN=300
# RATE_CONVERSATIONS_PER_IP_PER_HOUR=30
# Трейсы LLM в Langfuse (P7-03, ADR-0029): без обоих ключей выключены. HOST пусто — Cloud EU
# (https://cloud.langfuse.com), US — https://us.cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Таймаут отправки пачки трейсов, с (фоновый поток; медленный канал/прокси — больше).
# LANGFUSE_TIMEOUT_S=30
APP_ENV=local

# Ключи виджета, которые `make seed` выдаст новым тенантам (иначе сгенерирует и напечатает):
# slug=key[,slug=key…], например demo-beauty=wk_dev_demo_beauty,demo-garden=wk_dev_demo_garden.
SEED_WIDGET_KEY=

# Токен API админки (Authorization: Bearer …) до пользователей админки (P8-01, ADR-0028).
# Пусто — эндпоинты /v1/admin отвечают 404.
ADMIN_API_TOKEN=

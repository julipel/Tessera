# Боевое окружение (P9-01, docs/deploy.md): скопировать в deploy/.env на сервере и
# заполнить. В git — только этот шаблон (.env в .gitignore).
# DATABASE_URL, REDIS_URL, QDRANT_URL, CORS_ORIGINS, KNOWLEDGE_FILES_DIR задаёт compose.prod.yml.

# Домен сервера: A-запись на IP, порты 80/443 открыты. localhost — проверка стека локально.
DOMAIN=
# Срок HSTS, с (Caddy): сутки до проверки домена после выкладки, затем 31536000 (год).
# Для DOMAIN=localhost — 0, иначе браузер переведёт на https и http://localhost:* разработки.
HSTS_MAX_AGE=86400
# Подсеть compose: API доверяет X-Forwarded-For только адресам из неё. Менять, если
# 172.30.240.0/24 пересекается с сетями сервера (он из стандартных пулов Docker 172.17–31).
# COMPOSE_SUBNET=172.30.240.0/24
# Тег образов при сборке; откат — сборка нужного коммита с другим тегом (docs/deploy.md).
IMAGE_TAG=latest

POSTGRES_USER=app
# Обязательно: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=app

LOG_LEVEL=INFO
QDRANT_COLLECTION=knowledge
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Провайдеры LLM (ADR-0010) — те, что указаны в AgentConfig тенантов.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
ANTHROPIC_API_KEY=

# Реранкинг (ADR-0015); пусто — выключен.
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=

# Трейсы Langfuse (ADR-0029); без ключей выключены.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Лимиты частоты публичного API (ADR-0030); 0 — правило выключено.
RATE_TURNS_PER_IP_PER_MIN=20
RATE_TURNS_PER_TENANT_PER_MIN=300
RATE_CONVERSATIONS_PER_IP_PER_HOUR=30

# Ключи виджета для новых тенантов при make deploy-seed (slug=key,…); пусто — сгенерировать
# и напечатать. Dev-ключи wk_dev_* в бою не использовать.
SEED_WIDGET_KEY=

# Секреты источников http_api/database (ADR-0017): SOURCE_SECRET_<ИМЯ>=…

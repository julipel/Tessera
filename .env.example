# При изменении POSTGRES_* обнови DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
NEXT_PUBLIC_API_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge
# Эмбеддинги чанков знаний (ключ и base_url — OPENAI_*). Смена модели — новая коллекция.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Реранкинг search_knowledge (ADR-0015): полный URL /rerank в формате Cohere/Jina, напр.
# https://api.cohere.com/v2/rerank (rerank-v3.5) или https://api.jina.ai/v1/rerank
# (jina-reranker-v2-base-multilingual). Пусто — без реранкинга.
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
# Файлы источников file: <dir>/<tenant_id>/<source_id>/. По умолчанию — data/knowledge в корне.
# KNOWLEDGE_FILES_DIR=/srv/knowledge
# Секреты источников http_api/database (ADR-0017): конфиг ссылается на имя переменной,
# разрешены только SOURCE_SECRET_*.
# SOURCE_SECRET_DEMO_API=
# provider: openai — OpenAI Responses API (ADR-0010). Пусто — официальный endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# provider: openai_compatible — Chat Completions совместимого API, напр. https://routerai.ru/api/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
ANTHROPIC_API_KEY=
EMBEDDINGS_MODEL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
APP_ENV=local

# Ключ виджета, который `make seed` выдаст новому тенанту (иначе сгенерирует и напечатает).
SEED_WIDGET_KEY=

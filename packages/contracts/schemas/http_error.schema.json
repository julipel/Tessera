{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http_error.schema.json",
  "title": "HttpError",
  "description": "Тело любого HTTP-ответа с ошибкой (4xx/5xx) публичного API. Коды — docs/contracts.md §6.",
  "type": "object",
  "properties": {
    "error": { "$ref": "#/$defs/HttpErrorBody" }
  },
  "required": ["error"],
  "additionalProperties": false,
  "$defs": {
    "HttpErrorBody": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Коды SSE-ошибок (events.schema.json ErrorData) плюс только HTTP: unauthorized (401), forbidden (403), not_found (404), duplicate_message (409).",
          "enum": [
            "llm_unavailable",
            "turn_timeout",
            "step_limit",
            "invalid_input",
            "conversation_not_found",
            "rate_limited",
            "internal",
            "unauthorized",
            "forbidden",
            "not_found",
            "duplicate_message"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      },
      "required": ["code", "message", "retryable"],
      "additionalProperties": false
    }
  }
}

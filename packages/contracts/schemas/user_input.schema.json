{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user_input.schema.json",
  "title": "UserInput",
  "description": "Ввод пользователя в POST .../messages: текст, нажатие action-кнопки или отправка формы.",
  "oneOf": [
    { "$ref": "#/$defs/TextInput" },
    { "$ref": "#/$defs/ActionInput" },
    { "$ref": "#/$defs/FormSubmitInput" }
  ],
  "$defs": {
    "TextInput": {
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "ActionInput": {
      "type": "object",
      "description": "Нажатие Action-кнопки компонента (см. components.schema.json).",
      "properties": {
        "type": { "const": "action" },
        "action_id": { "type": "string", "minLength": 1 },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Что увидел пользователь (подпись кнопки, при необходимости с названием позиции): показывается в истории и передаётся модели. Нет — вместо подписи action_id."
        },
        "payload": { "type": "object", "default": {} }
      },
      "required": ["type", "action_id"],
      "additionalProperties": false
    },
    "FormSubmitInput": {
      "type": "object",
      "description": "Отправка формы (component.type=form). Ключи values соответствуют FormField.name.",
      "properties": {
        "type": { "const": "form_submit" },
        "form_id": { "type": "string", "minLength": 1 },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Что увидел пользователь (заголовок формы): показывается в истории вместо form_id. Модели не передаётся — она получает form_id и values."
        },
        "values": { "type": "object" }
      },
      "required": ["type", "form_id", "values"],
      "additionalProperties": false
    }
  }
}

# При изменении POSTGRES_* обнови DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
NEXT_PUBLIC_API_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
OPENAI_API_KEY=
# Пусто — официальный endpoint; для OpenAI-совместимого прокси, напр. https://routerai.ru/api/v1
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
EMBEDDINGS_MODEL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
APP_ENV=local

# Ключ виджета, который `make seed` выдаст новому тенанту (иначе сгенерирует и напечатает).
SEED_WIDGET_KEY=

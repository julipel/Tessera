# Вход на сервер (P9-01, ADR-0040): TLS от Let's Encrypt для {$DOMAIN} (localhost —
# внутренний сертификат Caddy, для проверки стека на машине разработчика).
{
	# Адрес для писем Let's Encrypt о проблемах с сертификатом (D-13).
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Заголовки безопасности на весь домен (P9-01v). HSTS — без includeSubDomains: поддомены
	# могут быть не нашими; срок — HSTS_MAX_AGE (сутки, пока домен не проверен; 0 — для
	# DOMAIN=localhost: браузер не закрепит https за localhost и сбросит прежний HSTS).
	# X-Frame-Options не ставим: встраивание решает CSP frame-ancestors из web — /widget по
	# ключу (proxy.ts, ADR-0022), остальное — 'none' (next.config.ts, админка — proxy.ts).
	# Server и X-Powered-By — без версий и названий ПО; камера, микрофон, геолокация и оплата
	# не нужны ни чату, ни админке (D-12).
	header {
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:86400}"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}

	# API: без сжатия — SSE-ход (text/event-stream) уходит посетителю по событию, без буфера.
	# X-Forwarded-For Caddy ставит сам; uvicorn берёт из него IP для лимитов (ADR-0030) и
	# доверяет только своей сети compose (FORWARDED_ALLOW_IPS). Входящий XFF клиента Caddy без
	# trusted_proxies не пропускает; если перед ним встанет CDN — trusted_proxies только
	# на его подсети, иначе лимиты по IP станут обходимыми (REVIEW.md: S-5).
	@api path /v1/* /health
	handle @api {
		# Первый рубеж против огромных тел; точные лимиты — в API (до 20 МБ — файлы
		# источников, 64 КБ — чат; REVIEW.md: C-3).
		request_body {
			max_size 25MB
		}
		reverse_proxy api:8000
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}

# www — постоянный редирект на основной домен (с путём и query): одна витрина, один origin
# для CORS и ключей виджета. Нужна A-запись www на тот же IP, иначе Caddy пишет в лог ошибки
# ACME для www (основной домен это не задевает).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

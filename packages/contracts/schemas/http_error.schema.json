{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http_error.schema.json",
  "title": "HttpError",
  "description": "Тело любого HTTP-ответа с ошибкой (4xx/5xx) публичного API. Коды — docs/contracts.md §6.",
  "type": "object",
  "properties": {
    "error": { "$ref": "#/$defs/HttpErrorBody" }
  },
  "required": ["error"],
  "additionalProperties": false,
  "$defs": {
    "HttpErrorBody": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Коды SSE-ошибок (events.schema.json ErrorData) плюс только HTTP: unauthorized (401), forbidden (403), not_found (404), duplicate_message (409), not_retryable (409).",
          "enum": [
            "llm_unavailable",
            "turn_timeout",
            "step_limit",
            "invalid_input",
            "conversation_not_found",
            "rate_limited",
            "internal",
            "unauthorized",
            "forbidden",
            "not_found",
            "duplicate_message",
            "not_retryable"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "array",
          "description": "Ошибки по местам ввода для invalid_input, если сервер их различает (AgentConfig в админке).",
          "items": { "$ref": "#/$defs/ErrorDetail" }
        }
      },
      "required": ["code", "message", "retryable"],
      "additionalProperties": false
    },
    "ErrorDetail": {
      "type": "object",
      "description": "Ошибка в одном месте ввода: loc — путь (ключи и индексы), пустой — весь ввод.",
      "properties": {
        "loc": { "type": "array", "items": { "type": ["string", "integer"] } },
        "message": { "type": "string" }
      },
      "required": ["loc", "message"],
      "additionalProperties": false
    }
  }
}
